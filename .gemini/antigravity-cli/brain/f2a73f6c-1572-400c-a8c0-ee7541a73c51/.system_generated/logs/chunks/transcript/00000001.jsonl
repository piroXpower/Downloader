{"step_index":183,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-02T08:10:04Z","content":"Created At: 2026-10-02T13:40:04+05:30\nCompleted At: 2026-10-02T13:40:10+05:30\n\nThe command exited with code 0.\nOutput:\npause source:\r\n     @statictypes\r\n    @mtproto_required\r\n    async def pause(\r\n        self,\r\n        chat_id: int | str,\r\n    ) -> bool:\r\n        chat_id = await self.resolve_chat_id(chat_id)\r\n        try:\r\n            return await self._binding.pause(chat_id)\r\n        except ConnectionNotFound:\r\n            raise NotInCallError()\r\n\r\nresume source:\r\n     @statictypes\r\n    @mtproto_required\r\n    async def resume(\r\n        self,\r\n        chat_id: int | str,\r\n    ) -> bool:\r\n        chat_id = await self.resolve_chat_id(chat_id)\r\n        try:\r\n            return await self._binding.resume(chat_id)\r\n        except ConnectionNotFound:\r\n            raise NotInCallError()\r\n\r\nchange_volume_call source:\r\n     @statictypes\r\n    @mtproto_required\r\n    async def change_volume_call(\r\n        self,\r\n        chat_id: int | str,\r\n        volume: int,\r\n    ):\r\n        chat_id = await self.resolve_chat_id(chat_id)\r\n        if chat_id >= 0:  # type: ignore\r\n            raise UnsupportedMethod()\r\n        input_call = await self._app.get_input_call(\r\n            chat_id,\r\n        )\r\n        if input_call is None:\r\n            raise NoActiveGroupCall()\r\n\r\n        await self._app.change_volume(\r\n            chat_id,\r\n            volume,\r\n            self._cache_user_peer.get(chat_id),\r\n        )\r\n\r\nleave_call source:\r\n     @statictypes\r\n    @mtproto_required\r\n    @mutex\r\n    async def leave_call(\r\n        self,\r\n        chat_id: int | str,\r\n        close: bool = False,\r\n    ):\r\n        chat_id = await self.resolve_chat_id(chat_id)\r\n        is_p2p_waiting = (\r\n            chat_id in self._p2p_configs\r\n            and not self._p2p_configs[chat_id].wait_data.done()\r\n        )\r\n        is_group = False\r\n        if not is_p2p_waiting:\r\n            try:\r\n                is_group = await self._binding.get_call_type(chat_id) in (\r\n                    CallType.GROUP,\r\n                    CallType.CONFERENCE,\r\n                )\r\n                await self._binding.stop(chat_id)\r\n            except ConnectionNotFound:\r\n                raise NotInCallError()\r\n        if is_group:\r\n            input_call = await self._app.get_input_call(\r\n                chat_id,\r\n            )\r\n\r\n            if input_call is None:\r\n                raise NoActiveGroupCall()\r\n\r\n            await self._app.leave_group_call(\r\n                chat_id,\r\n            )\r\n        else:\r\n            await self._app.discard_call(chat_id, False)\r\n        if is_p2p_waiting:\r\n            self._p2p_configs.pop(chat_id)\r\n            return\r\n        if is_group:\r\n            self._clear_cache(chat_id)  # type: ignore\r\n\r\n        if chat_id < 0 and close:  # type: ignore\r\n            await self._app.close_voice_chat(chat_id)\r\n\r\n\n"}
