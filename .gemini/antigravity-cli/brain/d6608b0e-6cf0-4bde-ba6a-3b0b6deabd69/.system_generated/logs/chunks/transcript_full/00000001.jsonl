{"step_index":47,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-02T08:23:49Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>Tower Stack 3D</title>\n  <script src=\"https://telegram.org/js/telegram-web-app.js\"></script>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }\n    body {\n      background: #0f172a;\n      color: #fff;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      min-height: 100vh;\n      overflow: hidden;\n      touch-action: manipulation;\n    }\n    .hud {\n      display: flex;\n      justify-content: space-between;\n      width: 90vw;\n      max-width: 360px;\n      margin-bottom: 8px;\n      font-weight: bold;\n      color: #38bdf8;\n    }\n    #canvas {\n      background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);\n      border: 2px solid #334155;\n      border-radius: 12px;\n      box-shadow: 0 0 20px rgba(0,0,0,0.5);\n      width: 90vw;\n      max-width: 360px;\n      height: 75vh;\n      max-height: 540px;\n    }\n    .hint {\n      margin-top: 8px;\n      color: #94a3b8;\n      font-size: 13px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"hud\">\n    <div>STACK: <span id=\"score\">0</span></div>\n    <div>BEST: <span id=\"best\">0</span></div>\n  </div>\n  <canvas id=\"canvas\"></canvas>\n  <div class=\"hint\">Tap screen to place block perfectly!</div>\n\n  <script>\n    const tg = window.Telegram?.WebApp;\n    if (tg) tg.expand();\n\n    const canvas = document.getElementById('canvas');\n    const ctx = canvas.getContext('2d');\n    canvas.width = 360;\n    canvas.height = 540;\n\n    const blockHeight = 24;\n    let stack = [];\n    let currentBlock = null;\n    let dir = 1;\n    let speed = 3.5;\n    let score = 0;\n    let best = parseInt(localStorage.getItem('stack_best') || '0', 10);\n    document.getElementById('best').innerText = best;\n    let gameOver = false;\n\n    const palette = [\n      '#ef4444', '#f97316', '#f59e0b', '#10b981', '#06b6d4', '#3b82f6', '#8b5cf6', '#ec4899'\n    ];\n\n    function getColor(index) {\n      return palette[index % palette.length];\n    }\n\n    function initGame() {\n      stack = [\n        { x: 80, width: 200, y: canvas.height - blockHeight * 2, color: getColor(0) }\n      ];\n      score = 0;\n      speed = 3.5;\n      gameOver = false;\n      document.getElementById('score').innerText = '0';\n      spawnCurrent();\n    }\n\n    function spawnCurrent() {\n      const top = stack[stack.length - 1];\n      currentBlock = {\n        x: 0,\n        width: top.width,\n        y: top.y - blockHeight,\n        color: getColor(stack.length)\n      };\n      dir = 1;\n    }\n\n    function placeBlock() {\n      if (gameOver) {\n        initGame();\n        return;\n      }\n\n      const top = stack[stack.length - 1];\n      const diff = currentBlock.x - top.x;\n\n      if (Math.abs(diff) < 3) {\n        // Perfect match bonus!\n        currentBlock.x = top.x;\n        if (tg?.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');\n      } else if (Math.abs(diff) >= currentBlock.width) {\n        // Missed completely!\n        return endGame();\n      } else {\n        // Cut block\n        if (diff > 0) {\n          currentBlock.width -= diff;\n        } else {\n          currentBlock.width += diff;\n          currentBlock.x = top.x;\n        }\n        if (tg?.HapticFeedback) tg.HapticFeedback.impactOccurred('light');\n      }\n\n      stack.push(currentBlock);\n      score++;\n      document.getElementById('score').innerText = score;\n      if (score > best) {\n        best = score;\n        localStorage.setItem('stack_best', best);\n        document.getElementById('best').innerText = best;\n      }\n\n      // Scroll camera view down if stack reaches high\n      if (currentBlock.y < canvas.height / 2) {\n        for (let b of stack) b.y += blockHeight;\n      }\n\n      speed = Math.min(7.5, speed + 0.1);\n      spawnCurrent();\n    }\n\n    function endGame() {\n      gameOver = true;\n      if (tg?.HapticFeedback) tg.HapticFeedback.notificationOccurred('error');\n      window.parent.postMessage({\n        type: 'SCORE_UPDATE',\n        gameId: 'game-tower-stack',\n        score: score\n      }, '*');\n    }\n\n    window.addEventListener('pointerdown', placeBlock);\n    window.addEventListener('keydown', e => { if (e.code === 'Space') placeBlock(); });\n\n    function update() {\n      if (!gameOver && currentBlock) {\n        currentBlock.x += speed * dir;\n        if (currentBlock.x + currentBlock.width > canvas.width) {\n          dir = -1;\n        } else if (currentBlock.x < 0) {\n          dir = 1;\n        }\n      }\n    }\n\n    function draw() {\n      ctx.fillStyle = '#0f172a';\n      ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n      // Draw Stack\n      stack.forEach(b => {\n        ctx.fillStyle = b.color;\n        ctx.fillRect(b.x, b.y, b.width, blockHeight - 2);\n        // Highlight top rim\n        ctx.fillStyle = 'rgba(255,255,255,0.2)';\n        ctx.fillRect(b.x, b.y, b.width, 3);\n      });\n\n      // Draw Moving Block\n      if (!gameOver && currentBlock) {\n        ctx.fillStyle = currentBlock.color;\n        ctx.fillRect(currentBlock.x, currentBlock.y, currentBlock.width, blockHeight - 2);\n        ctx.fillStyle = 'rgba(255,255,255,0.3)';\n        ctx.fillRect(currentBlock.x, currentBlock.y, currentBlock.width, 3);\n      }\n\n      if (gameOver) {\n        ctx.fillStyle = 'rgba(0,0,0,0.6)';\n        ctx.fillRect(0, 0, canvas.width, canvas.height);\n        ctx.fillStyle = '#ef4444';\n        ctx.font = 'bold 28px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('GAME OVER', canvas.width / 2, 220);\n        ctx.fillStyle = '#ffffff';\n        ctx.font = '20px sans-serif';\n        ctx.fillText('Final Height: ' + score, canvas.width / 2, 260);\n        ctx.fillStyle = '#38bdf8';\n        ctx.font = '16px sans-serif';\n        ctx.fillText('Tap to Try Again', canvas.width / 2, 310);\n      }\n    }\n\n    function loop() {\n      update();\n      draw();\n      requestAnimationFrame(loop);\n    }\n\n    initGame();\n    loop();\n  </script>\n</body>\n</html>\n","Description":"Create Tower Stack 3D mini-game","Overwrite":true,"TargetFile":"/root/telegram_game_bot/webapp/static/games/tower_stack/index.html","toolAction":"Creating Tower Stack game","toolSummary":"Create Tower Stack HTML5 game"}}]}
