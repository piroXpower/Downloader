      return false;\n    }\n\n    function merge(arena, player) {\n      player.matrix.forEach((row, y) => {\n        row.forEach((value, x) => {\n          if (value !== 0) arena[y + player.pos.y][x + player.pos.x] = value;\n        });\n      });\n    }\n\n    function rotate(matrix, dir) {\n      for (let y = 0; y < matrix.length; ++y) {\n        for (let x = 0; x < y; ++x) {\n          [matrix[x][y], matrix[y][x]] = [matrix[y][x], matrix[x][y]];\n        }\n      }\n      if (dir > 0) matrix.forEach(row => row.reverse());\n      else matrix.reverse();\n    }\n\n    function playerRotate(dir) {\n      const pos = player.pos.x;\n      let offset = 1;\n      rotate(player.matrix, dir);\n      while (collide(arena, player)) {\n        player.pos.x += offset;\n        offset = -(offset + (offset > 0 ? 1 : -1));\n        if (offset > player.matrix[0].length) {\n          rotate(player.matrix, -dir);\n          player.pos.x = pos;\n          return;\n        }\n      }\n      if (tg?.HapticFeedback) tg.HapticFeedback.selectionChanged();\n    }\n\n    function arenaSweep() {\n      let rowCount = 1;\n      outer: for (let y = arena.length - 1; y > 0; --y) {\n        for (let x = 0; x < arena[y].length; ++x) {\n          if (arena[y][x] === 0) continue outer;\n        }\n        const row = arena.splice(y, 1)[0].fill(0);\n        arena.unshift(row);\n        ++y;\n        score += rowCount * 100;\n        lines++;\n        rowCount *= 2;\n        if (tg?.HapticFeedback) tg.HapticFeedback.impactOccurred('medium');\n      }\n      document.getElementById('score').innerText = score;\n      document.getElementById('lines').innerText = lines;\n    }\n\n    function playerReset() {\n      const pieces = 'ILJOTSZ';\n      player.matrix = createPiece(pieces[pieces.length * Math.random() | 0]);\n      player.pos.y = 0;\n      player.pos.x = (arena[0].length / 2 | 0) - (player.matrix[0].length / 2 | 0);\n      if (collide(arena, player)) {\n        window.parent.postMessage({\n          type: 'SCORE_UPDATE',\n          gameId: 'game-tetris',\n          score: score\n        }, '*');\n        if (tg?.HapticFeedback) tg.HapticFeedback.notificationOccurred('error');\n        alert(`Game Over! Score: ${score}`);\n        arena.forEach(row => row.fill(0));\n        score = 0; lines = 0;\n        document.getElementById('score').innerText = 0;\n        document.getElementById('lines').innerText = 0;\n      }\n    }\n\n    function move(dir) {\n      player.pos.x += dir;\n      if (collide(arena, player)) {\n        player.pos.x -= dir;\n      } else {\n        if (tg?.HapticFeedback) tg.HapticFeedback.selectionChanged();\n      }\n    }\n\n    function drop() {\n      player.pos.y++;\n      if (collide(arena, player)) {\n        player.pos.y--;\n        merge(arena, player);\n        playerReset();\n        arenaSweep();\n      }\n      dropCounter = 0;\n    }\n\n    let dropCounter = 0;\n    let dropInterval = 800;\n    let lastTime = 0;\n\n    function drawMatrix(matrix, offset) {\n      matrix.forEach((row, y) => {\n        row.forEach((value, x) => {\n          if (value !== 0) {\n            ctx.fillStyle = colors[value];\n            ctx.fillRect(x + offset.x, y + offset.y, 1, 1);\n            ctx.lineWidth = 0.05;\n            ctx.strokeStyle = '#000';\n            ctx.strokeRect(x + offset.x, y + offset.y, 1, 1);\n          }\n        });\n      });\n    }\n\n    function draw() {\n      ctx.fillStyle = '#111827';\n      ctx.fillRect(0, 0, canvas.width, canvas.height);\n      drawMatrix(arena, {x: 0, y: 0});\n      drawMatrix(player.matrix, player.pos);\n    }\n\n    function update(time = 0) {\n      const deltaTime = time - lastTime;\n      lastTime = time;\n      dropCounter += deltaTime;\n      if (dropCounter > dropInterval) {\n        drop();\n      }\n      draw();\n      requestAnimationFrame(update);\n    }\n\n    window.addEventListener('keydown', e => {\n      if (e.key === 'ArrowLeft') move(-1);\n      if (e.key === 'ArrowRight') move(1);\n      if (e.key === 'ArrowDown') drop();\n      if (e.key === 'ArrowUp') playerRotate(1);\n    });\n\n    playerReset();\n    update();\n  </script>\n</body>\n</html>\n","Description":"Create Tetris Block Master mini-game","Overwrite":true,"TargetFile":"/root/telegram_game_bot/webapp/static/games/tetris/index.html","toolAction":"Creating Tetris game","toolSummary":"Create Tetris HTML5 game"}}]}
