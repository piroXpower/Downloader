import urllib.request, json
import base64
from Crypto.Cipher import DES

DES_KEY = b'38346591'

def decrypt_url(enc_url: str) -> str:
    cipher = DES.new(DES_KEY, DES.MODE_ECB)
    dec = cipher.decrypt(base64.b64decode(enc_url.strip()))
    # Unpad PKCS5
    pad = dec[-1]
    return dec[:-pad].decode('utf-8')

