# Telegram Game Bot Configuration

# 1. Obtain your Bot Token from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# 2. Your Bot's username (without @)
BOT_USERNAME=MyGameHubBot

# 3. WebApp URL
# For local testing, use http://localhost:8080 or your VPS public IP / ngrok / Cloudflare Tunnel
# Example: https://my-cool-games.ngrok-free.app or https://games.yourdomain.com
WEBAPP_URL=http://localhost:8080

# 4. Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 5. Optional Admin IDs (comma-separated Telegram numeric user IDs)
ADMIN_IDS=12345678,98765432
